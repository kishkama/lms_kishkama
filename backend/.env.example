# SQLite for local dev (default). For production, use a Postgres 17 asyncpg URL, e.g.:
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/learnflow
DATABASE_URL=sqlite+aiosqlite:///./learnflow.db

# Generate a real secret for any non-local environment, e.g.: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=dev-only-secret-change-me
JWT_ALGORITHM=HS256

ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_MINUTES=10080
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30

MIN_PASSWORD_LENGTH=8

# JSON array of allowed frontend origins, e.g.: CORS_ORIGINS=["http://localhost:5173","https://app.learnflow.example"]
CORS_ORIGINS=["http://localhost:5173"]
