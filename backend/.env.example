# SQLite for local dev (default).
DATABASE_URL=sqlite+aiosqlite:///./learnflow.db

# Neon (Cloud Run / production): use the asyncpg driver with Neon's connection
# string as-is — its `sslmode=require` query param is auto-translated to
# asyncpg's `ssl` connect arg (see app/db/engine.py). Get the exact string
# from the Neon dashboard's "Connection Details" panel.
# DATABASE_URL=postgresql+asyncpg://<user>:<password>@<endpoint>.neon.tech/<dbname>?sslmode=require

# Generate a real secret for any non-local environment, e.g.: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=dev-only-secret-change-me
JWT_ALGORITHM=HS256

ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_MINUTES=10080
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30

MIN_PASSWORD_LENGTH=8

# JSON array of allowed frontend origins, e.g.: CORS_ORIGINS=["http://localhost:5173","https://app.learnflow.example"]
CORS_ORIGINS=["http://localhost:5173"]
